# Copy to .env.local for local development. Never commit the filled-in file.
# On Render these are set in the dashboard (see render.yaml).

# --- Twelve Labs (video indexing + search) ---
TWELVE_LABS_API_KEY=
TWELVE_LABS_INDEX_ID=

# --- MongoDB (Atlas connection string) ---
DATABASE_URL=

# --- Redis (BullMQ queue) ---
QUEUE_URL=
# Namespaces the queue keys. Set a unique value per environment/developer so
# workers on a shared Redis never steal each other's jobs. Defaults to "bull".
QUEUE_PREFIX=

# --- Cloudinary (video storage + clip transformations) ---
# NEXT_PUBLIC_* values are exposed to the browser — never put a secret here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
